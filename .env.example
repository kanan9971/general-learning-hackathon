# --- LLM (xAI Grok, OpenAI-compatible) ---
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL_FAST=grok-4.20-0309-non-reasoning
XAI_MODEL_REASONING=grok-4.20-0309-reasoning
# --- Embeddings (Alibaba Model Studio / DashScope; OpenAI is blocked in Hong Kong) ---
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMS=1536
# --- Supabase ---
SUPABASE_URL=https://apsojsuiginpuqljutyo.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for legacy HS256 projects. New projects use asymmetric keys, verified via JWKS from SUPABASE_URL.
SUPABASE_JWT_SECRET=
# --- Market data / news ---
FRED_API_KEY=  # optional; rates come from Treasury.gov (keyless)
# Comma-separated; empty = current defaults (feeds.content.dowjones.io). The old feeds.a.dj.com host is frozen since Jan 2025.
WSJ_RSS_FEEDS=
YAHOO_USER_AGENT=Mozilla/5.0
# --- App ---
CRON_SECRET=
# demo = golden day, no network (app/data/golden_markets.json) · live = Yahoo/yfinance/Treasury/RSS with fallback
DATA_MODE=demo
# Local only: requests without a token act as a fixed dev user (mobile app has no login yet). Ignored on Vercel.
AUTH_DEV_BYPASS=false
DEV_FIXTURES=false
DEMO_DATE=
ALLOWED_ORIGINS=*
# Adaptive quiz: HMAC secret for MCQ answer seals (never returned to clients).
QUIZ_HMAC_SECRET=deskready-dev-quiz-hmac
# Force in-memory quiz store (tests / offline). Auto-on when no JWT under AUTH_DEV_BYPASS.
QUIZ_USE_MEMORY=false
